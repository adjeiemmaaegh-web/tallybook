# Standalone builds use no cloud settings. Set both fields for the shared shop.
# Never commit real API keys or secrets.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Telegram bot username (no @), e.g. TallybookBot. Only used to build the
# owner's "Open in Telegram" deep link on the Team tab. The bot token and
# webhook secret are NEVER here — they live only in Supabase function secrets.
# See supabase/functions/tallybook-telegram/README.md.
VITE_TALLYBOOK_TELEGRAM_BOT=

# REVIEW ONLY: disabled by default. Use a dedicated test Supabase project.
# No business cloud sync, auth gate, or real payments are enabled by this flag.
VITE_TALLYBOOK_SUPABASE_AUTH_PREVIEW=false
# Isolated website test only: verify a Supabase account before opening the local ledger.
# Use a dedicated test origin and Supabase project; do not turn this on for existing offline users.
VITE_TALLYBOOK_FRIENDS_TEST_MODE=false

# Require verified cloud owner entry. Missing configuration fails closed.
VITE_TALLYBOOK_REQUIRE_AUTH=false

# Strict cloud-account launch only: previously verified device owners cannot reopen
# their local ledger offline. Do not enable until hosted auth, backup, recovery,
# and production session-revocation acceptance are verified.
# Standalone offline-first installations must keep this disabled.
VITE_TALLYBOOK_MANDATORY_ONLINE_AUTH=false

# One-way clean launch: set an 8-80 character unique release epoch ONLY after
# verified backup, completed server reset, and mandatory auth go-live.
# Wipes ALL prior origin IndexedDB, local/session storage, PWA caches and workers
# on the next online visit, including local-only financial records.
# Keep empty in normal development and standalone installations.
VITE_TALLYBOOK_FRESH_START_EPOCH=

# Test and release tooling (payment sandbox, relay rehearsal, device acceptance). Never enable in production.
VITE_TALLYBOOK_INTERNAL_TOOLS=false

# Optional error reporting. Leave empty to keep every error on the device.
# When set it must be https. Reports hold only a short message, a scrubbed stack,
# the page path, the release label and the browser string. If the CSP is ever
# enforced, add this host to connect-src in vercel.json.
VITE_TALLYBOOK_ERROR_REPORT_URL=
VITE_TALLYBOOK_RELEASE=

# Free problem reporting: the "Report a problem" button lets a person send scrubbed
# error details by WhatsApp, share or copy. Optionally set the number it opens, in
# international format, for example +233240000000. Empty: they choose the contact.
VITE_TALLYBOOK_SUPPORT_WHATSAPP=
